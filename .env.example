# Clé de signature des sessions JWT (cookie httpOnly alba_session).
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changer-moi-par-une-cle-aleatoire-d-au-moins-32-octets

# Supabase — côté SERVEUR uniquement (jamais NEXT_PUBLIC_, jamais dans un
# composant client). service_role contourne RLS : réservé à lib/server/.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_du_dashboard_supabase

# Mode simulation NabooPay — teste tout le flux (checkout + webhook signé +
# activation automatique de l'abonnement) sans clé API réelle ni réseau.
# Mettre à 'mock' en développement local, retirer en production.
NABOOPAY_MOCK=mock
